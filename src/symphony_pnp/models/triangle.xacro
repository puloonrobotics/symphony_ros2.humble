<?xml version="1.0"?>
<robot name="triangle">

<link name="base_link">
  <collision>
    <origin xyz="0.4 0.1 0.06" rpy="0 0 -1.57"/>
    <geometry>
        <box size="0.05 0.043 0.06"/>
    </geometry>
  </collision>

  <visual>
    <origin xyz="0.4 0.1 0.03" rpy="0 0 -1.57"/>
    <geometry>
        <mesh filename="file://$(find symphony_pnp)/models/triangle.dae"/>
    </geometry>
  </visual>

  <inertial>
    <origin xyz="0.4 0.1 0.06" rpy="0 0 -1.57" />
    <mass value="0.05" />
    <inertia
      ixx="2.2708e-5" ixy="0.0" ixz="0.0"
      iyy="2.5417e-5" iyz="0.0"
      izz="1.8121e-5" />
  </inertial>
  </link>

<gazebo reference="base_link">
  <material>Gazebo/Purple</material>
    <mu1>20.0</mu1>
    <mu2>20.0</mu2>
</gazebo>

</robot>
